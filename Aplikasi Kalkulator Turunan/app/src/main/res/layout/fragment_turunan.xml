<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/fragment_turunan.xml
    PERUBAHAN UTAMA vs versi lama:
    1. Root → CoordinatorLayout (bukan NestedScrollView)
    2. NestedScrollView hanya berisi konten atas
    3. keyboardPanel → layout_gravity="bottom" agar selalu sticky
    4. LinearLayout langkah-langkah → RecyclerView (id: rvSteps)
    5. Padding bawah NestedScrollView diatur dari Java sesuai tinggi keyboard
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <!-- =========================================================== -->
    <!-- AREA SCROLL — semua konten kecuali keyboard                  -->
    <!-- =========================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Label input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masukkan Fungsi"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- INPUT CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <EditText
                        android:id="@+id/inputFunction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/btnClear"
                        android:background="@android:color/transparent"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:inputType="none"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:singleLine="true"
                        android:hint="f(x) = ..."
                        android:textColorHint="#9CA3AF"/>

                    <ImageButton
                        android:id="@+id/btnClear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_circle_gray"
                        android:src="@drawable/ic_close"
                        android:padding="6dp"
                        android:contentDescription="Hapus input"/>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label turunan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hasil Turunan"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- RESULT ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4FF"
                    app:strokeColor="#C7D7FF"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/txtHasil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:hint="f'(x) Tampil Di Sini"
                        android:textColorHint="#93A3BF"
                        android:textColor="#1D4FFF"
                        android:textStyle="bold"
                        android:textSize="20sp"/>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Label grafik -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Grafik"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- GRAFIK CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#EEF2FF"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"/>

                    <!-- Floating controls -->
                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnZoomIn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:textColor="#4B5563"
                            android:textAllCaps="false"
                            android:backgroundTint="#FFFFFF"
                            android:alpha="0.92"
                            android:elevation="4dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#E5E7EB"
                            app:strokeWidth="1dp"/>

                        <Button
                            android:id="@+id/btnZoomOut"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:textColor="#4B5563"
                            android:textAllCaps="false"
                            android:backgroundTint="#FFFFFF"
                            android:alpha="0.92"
                            android:elevation="4dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#E5E7EB"
                            app:strokeWidth="1dp"/>

                    </LinearLayout>

                    <!-- Legend -->
                    <LinearLayout
                        android:id="@+id/chartLegend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="18dp"
                                android:layout_height="3dp"
                                android:background="#2962FF"/>

                            <TextView
                                android:id="@+id/legendFx"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#374151"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="18dp"
                                android:layout_height="3dp"
                                android:background="#FF5252"/>

                            <TextView
                                android:id="@+id/legendDfx"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#374151"/>
                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label langkah -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Langkah Penyelesaian"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111827"/>

            <!-- ======================================================= -->
            <!-- RECYCLERVIEW — menggantikan 4 step card statis           -->
            <!-- nestedScrollingEnabled=false agar NestedScrollView yg    -->
            <!-- handle scroll, bukan RecyclerView sendiri                -->
            <!-- ======================================================= -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- =========================================================== -->
    <!-- KEYBOARD PANEL — sticky di bawah, tidak ikut scroll          -->
    <!-- layout_gravity="bottom" + elevation bikin selalu di atas     -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/keyboardPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <!-- Handle untuk menutup keyboard -->
        <LinearLayout
            android:id="@+id/btnHideKeyboard"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#E5E7EB"
                android:backgroundTint="#D1D5DB"/>
        </LinearLayout>

        <!-- Garis tipis pemisah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E5E7EB"
            android:layout_marginBottom="8dp"/>

        <!-- Row 1: sin cos tan ln log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnSin"  style="@style/KeyboardButtonStyle" android:text="sin"/>
            <Button android:id="@+id/btnCos"  style="@style/KeyboardButtonStyle" android:text="cos"/>
            <Button android:id="@+id/btnTan"  style="@style/KeyboardButtonStyle" android:text="tan"/>
            <Button android:id="@+id/btnLn"   style="@style/KeyboardButtonStyle" android:text="ln"/>
            <Button android:id="@+id/btnLog"  style="@style/KeyboardButtonStyle" android:text="log"/>
        </LinearLayout>

        <!-- Row 2: √x x² xʸ π e -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btnSqrt"   style="@style/KeyboardButtonStyle" android:text="√x"/>
            <Button android:id="@+id/btnSquare" style="@style/KeyboardButtonStyle" android:text="x²"/>
            <Button android:id="@+id/btnPow"    style="@style/KeyboardButtonStyle" android:text="xʸ"/>
            <Button android:id="@+id/btnPi"     style="@style/KeyboardButtonStyle" android:text="π"/>
            <Button android:id="@+id/btnE"      style="@style/KeyboardButtonStyle" android:text="e"/>
        </LinearLayout>

        <!-- Row 3: 7 8 9 ÷ ⌫ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn7"         style="@style/KeyboardButtonStyle" android:text="7"/>
            <Button android:id="@+id/btn8"         style="@style/KeyboardButtonStyle" android:text="8"/>
            <Button android:id="@+id/btn9"         style="@style/KeyboardButtonStyle" android:text="9"/>
            <Button android:id="@+id/btnDivide"    style="@style/KeyboardButtonStyle" android:text="÷"/>
            <Button android:id="@+id/btnBackspace" style="@style/KeyboardButtonStyle" android:text="⌫"/>
        </LinearLayout>

        <!-- Row 4: 4 5 6 × ^ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn4"       style="@style/KeyboardButtonStyle" android:text="4"/>
            <Button android:id="@+id/btn5"       style="@style/KeyboardButtonStyle" android:text="5"/>
            <Button android:id="@+id/btn6"       style="@style/KeyboardButtonStyle" android:text="6"/>
            <Button android:id="@+id/btnMultiply" style="@style/KeyboardButtonStyle" android:text="×"/>
            <Button android:id="@+id/btnCaret"   style="@style/KeyboardButtonStyle" android:text="^"/>
        </LinearLayout>

        <!-- Row 5: 1 2 3 − ( -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn1"         style="@style/KeyboardButtonStyle" android:text="1"/>
            <Button android:id="@+id/btn2"         style="@style/KeyboardButtonStyle" android:text="2"/>
            <Button android:id="@+id/btn3"         style="@style/KeyboardButtonStyle" android:text="3"/>
            <Button android:id="@+id/btnMinus"     style="@style/KeyboardButtonStyle" android:text="−"/>
            <Button android:id="@+id/btnOpenParen" style="@style/KeyboardButtonStyle" android:text="("/>
        </LinearLayout>

        <!-- Row 6: 0 . ) + = -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn0"          style="@style/KeyboardButtonStyle" android:text="0"/>
            <Button android:id="@+id/btnDot"        style="@style/KeyboardButtonStyle" android:text="."/>
            <Button android:id="@+id/btnCloseParen" style="@style/KeyboardButtonStyle" android:text=")"/>
            <Button android:id="@+id/btnPlus"       style="@style/KeyboardButtonStyle" android:text="+"/>
            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:paddingTop="2dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1D4FFF"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Row 7: x  AC  Hitung Turunan -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">

            <Button
                android:id="@+id/btnX"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#F9FAFB"
                android:text="x"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp"/>

            <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:backgroundTint="#FFF3F3"
                android:text="AC"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp"/>

            <Button
                android:id="@+id/btnHitungBottom"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:layout_marginStart="5dp"
                android:backgroundTint="#1D4FFF"
                android:text="Hitung Turunan"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>