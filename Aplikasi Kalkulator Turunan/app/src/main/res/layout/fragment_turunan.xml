<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="80dp">


        <!-- ============================================================ -->
        <!-- LABEL: Masukkan fungsi                                        -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masukkan fungsi"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#111827"/>

        <!-- ============================================================ -->
        <!-- INPUT CARD                                                    -->
        <!-- ============================================================ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <EditText
                    android:id="@+id/inputFunction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/btnClear"
                    android:background="@android:color/transparent"
                    android:textSize="20sp"
                    android:textColor="#111827"
                    android:inputType="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_gray"
                    android:src="@drawable/ic_close"
                    android:padding="6dp"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- LABEL: Turunan                                                -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Turunan"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#111827"/>

        <!-- ============================================================ -->
        <!-- RESULT ROW: Result card + Hitung Turunan button              -->
        <!-- ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Result card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0F4FF"
                app:strokeColor="#C7D7FF"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtHasil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"

                    android:textColor="#1D4FFF"
                    android:textStyle="bold"
                    android:textSize="22sp"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Hitung Turunan button -->
            <Button
                android:id="@+id/btnHitung"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:backgroundTint="#1D4FFF"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Hitung Turunan"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"/>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- LABEL: Grafik                                                 -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Grafik"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#111827"/>

        <!-- ============================================================ -->
        <!-- GRAFIK CARD                                                   -->
        <!-- ============================================================ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- MPAndroidChart view -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"/>

                <!-- Zoom buttons -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnZoomIn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="false"
                        android:backgroundTint="#FFFFFF"
                        android:padding="0dp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"/>

                    <Button
                        android:id="@+id/btnZoomOut"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="−"
                        android:textSize="20sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="false"
                        android:backgroundTint="#FFFFFF"
                        android:padding="0dp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"/>

                    <Button
                        android:id="@+id/btnFullscreen"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="⛶"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="false"
                        android:backgroundTint="#FFFFFF"
                        android:padding="0dp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"/>

                </LinearLayout>

                <!-- Legend overlay -->
                <LinearLayout
                    android:id="@+id/chartLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <!-- f(x) legend -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="2dp"
                            android:background="#3B6FFF"/>

                        <TextView
                            android:id="@+id/legendFx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:textColor="#374151"/>

                    </LinearLayout>

                    <!-- f'(x) legend -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="12dp">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="2dp"
                            android:background="#FF4444"/>

                        <TextView
                            android:id="@+id/legendDfx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:textColor="#374151"/>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- LABEL: Langkah Penyelesaian                                   -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Langkah Penyelesaian"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827"/>

        <!-- ============================================================ -->
        <!-- STEPS CONTAINER (populated programmatically)                  -->
        <!-- ============================================================ -->

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- STEP 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Step header (always visible) -->
                    <LinearLayout
                        android:id="@+id/step1Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"

                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111827"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"

                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step1Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <!-- Step detail (collapsible) -->
                    <TextView
                        android:id="@+id/step1Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"

                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step2Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"

                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111827"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"

                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step2Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step2Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"

                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step3Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"

                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111827"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"

                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step3Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step3Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"

                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 4 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step4Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"

                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111827"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"

                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step4Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step4Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"

                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- HASIL AKHIR CARD                                              -->
        <!-- ============================================================ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F4FF"
            app:strokeColor="#C7D7FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hasil Akhir"
                    android:textColor="#1D4FFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/txtHasilAkhir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#1D4FFF"
                    android:textStyle="bold"
                    android:textSize="22sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- KEYBOARD SECTION                                              -->
        <!-- ============================================================ -->

        <!-- Row 1: Sin Cos Tan ln log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSin"
                style="@style/KeyboardButtonStyle"
                android:text="Sin"/>

            <Button
                android:id="@+id/btnCos"
                style="@style/KeyboardButtonStyle"
                android:text="Cos"/>

            <Button
                android:id="@+id/btnTan"
                style="@style/KeyboardButtonStyle"
                android:text="Tan"/>

            <Button
                android:id="@+id/btnLn"
                style="@style/KeyboardButtonStyle"
                android:text="ln"/>

            <Button
                android:id="@+id/btnLog"
                style="@style/KeyboardButtonStyle"
                android:text="log"/>

        </LinearLayout>

        <!-- Row 2: √x  x²  x^y  π  e -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSqrt"
                style="@style/KeyboardButtonStyle"
                android:text="√x"/>

            <Button
                android:id="@+id/btnSquare"
                style="@style/KeyboardButtonStyle"
                android:text="x²"/>

            <Button
                android:id="@+id/btnPow"
                style="@style/KeyboardButtonStyle"
                android:text="xʸ"/>

            <Button
                android:id="@+id/btnPi"
                style="@style/KeyboardButtonStyle"
                android:text="π"/>

            <Button
                android:id="@+id/btnE"
                style="@style/KeyboardButtonStyle"
                android:text="e"/>

        </LinearLayout>

        <!-- Row 3: 7  8  9  ÷  ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                style="@style/KeyboardButtonStyle"
                android:text="7"/>

            <Button
                android:id="@+id/btn8"
                style="@style/KeyboardButtonStyle"
                android:text="8"/>

            <Button
                android:id="@+id/btn9"
                style="@style/KeyboardButtonStyle"
                android:text="9"/>

            <Button
                android:id="@+id/btnDivide"
                style="@style/KeyboardButtonStyle"
                android:text="÷"/>

            <Button
                android:id="@+id/btnBackspace"
                style="@style/KeyboardButtonStyle"
                android:text="⌫"/>

        </LinearLayout>

        <!-- Row 4: 4  5  6  ×  ^ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                style="@style/KeyboardButtonStyle"
                android:text="4"/>

            <Button
                android:id="@+id/btn5"
                style="@style/KeyboardButtonStyle"
                android:text="5"/>

            <Button
                android:id="@+id/btn6"
                style="@style/KeyboardButtonStyle"
                android:text="6"/>

            <Button
                android:id="@+id/btnMultiply"
                style="@style/KeyboardButtonStyle"
                android:text="×"/>

            <Button
                android:id="@+id/btnCaret"
                style="@style/KeyboardButtonStyle"
                android:text="^"/>

        </LinearLayout>

        <!-- Row 5: 1  2  3  −  ( -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                style="@style/KeyboardButtonStyle"
                android:text="1"/>

            <Button
                android:id="@+id/btn2"
                style="@style/KeyboardButtonStyle"
                android:text="2"/>

            <Button
                android:id="@+id/btn3"
                style="@style/KeyboardButtonStyle"
                android:text="3"/>

            <Button
                android:id="@+id/btnMinus"
                style="@style/KeyboardButtonStyle"
                android:text="−"/>

            <Button
                android:id="@+id/btnOpenParen"
                style="@style/KeyboardButtonStyle"
                android:text="("/>

        </LinearLayout>

        <!-- Row 6: 0  .  )  +  = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn0"
                style="@style/KeyboardButtonStyle"
                android:text="0"/>

            <Button
                android:id="@+id/btnDot"
                style="@style/KeyboardButtonStyle"
                android:text="."/>

            <Button
                android:id="@+id/btnCloseParen"
                style="@style/KeyboardButtonStyle"
                android:text=")"/>

            <Button
                android:id="@+id/btnPlus"
                style="@style/KeyboardButtonStyle"
                android:text="+"/>

            <!-- = button: blue accent -->
            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#1D4FFF"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="14dp"/>

