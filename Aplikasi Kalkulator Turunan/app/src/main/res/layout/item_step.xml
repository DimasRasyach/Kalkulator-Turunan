<?xml version="1.0" encoding="utf-8"?>
<!--
    item_step.xml
    Layout satu item langkah penyelesaian.
    Dipakai oleh StepAdapter (RecyclerView).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (selalu tampil, bisa di-tap) -->
        <LinearLayout
            android:id="@+id/stepHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="?attr/selectableItemBackground">

            <!-- Nomor langkah -->
            <TextView
                android:id="@+id/tvStepNumber"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_step_number"
                android:gravity="center"
                android:textColor="#1D4FFF"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <!-- Judul langkah -->
            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#111827"/>

            <!-- Badge / label singkat -->
            <TextView
                android:id="@+id/tvStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:background="@drawable/bg_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

            <!-- Chevron arrow, diputar saat expanded -->
            <ImageView
                android:id="@+id/ivArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#9CA3AF"
                android:contentDescription="Toggle detail"/>

        </LinearLayout>

        <!-- Detail (collapsible) -->
        <TextView
            android:id="@+id/tvStepDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="62dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>