<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <!-- AREA SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Label input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masukkan limit fungsi"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- INPUT CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Row: lim x→a  f(x) -->
                    <LinearLayout
                        android:id="@+id/inputLimitRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/btnClear"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- lim x→a -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="lim"
                                android:textSize="18sp"
                                android:textStyle="italic|bold"
                                android:textColor="#1D4FFF"/>

                            <!-- x → a (input nilai batas) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="x→"
                                    android:textSize="13sp"
                                    android:textColor="#374151"/>

                                <EditText
                                    android:id="@+id/inputLimitValue"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:textSize="14sp"
                                    android:textColor="#1D4FFF"
                                    android:textStyle="bold"
                                    android:inputType="none"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:hint="a"
                                    android:textColorHint="#9CA3AF"
                                    android:singleLine="true"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- f(x) input -->
                        <EditText
                            android:id="@+id/inputFunction"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:textSize="20sp"
                            android:textColor="#111827"
                            android:inputType="none"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:singleLine="true"
                            android:hint="f(x) = ..."
                            android:textColorHint="#9CA3AF"/>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnClear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_circle_gray"
                        android:src="@drawable/ic_close"
                        android:padding="6dp"
                        android:contentDescription="Hapus input"/>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label hasil limit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hasil Limit"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- RESULT ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4FF"
                    app:strokeColor="#C7D7FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <!-- lim x→a kecil -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="lim"
                                android:textSize="14sp"
                                android:textStyle="italic|bold"
                                android:textColor="#1D4FFF"/>

                            <TextView
                                android:id="@+id/txtLimitLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="x→a"
                                android:textSize="11sp"
                                android:textColor="#1D4FFF"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtHasil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="f(x) = ..."
                            android:textColorHint="#93A3BF"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="20sp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Hitung Limit button -->
                <Button
                    android:id="@+id/btnHitung"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#1D4FFF"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Hitung Limit"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="14dp"/>

            </LinearLayout>

            <!-- Label grafik -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Grafik Fungsi"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#111827"/>

            <!-- GRAFIK CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#EEF2FF"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"/>

                    <!-- Label f(x) di pojok kiri atas -->
                    <TextView
                        android:id="@+id/txtChartFx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="8dp"
                        android:textSize="12sp"
                        android:textColor="#374151"
                        android:textStyle="italic"
                        android:visibility="gone"/>

                    <!-- Tooltip nilai limit -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tooltipCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#EEF2FF"
                        app:strokeColor="#C7D7FF"
                        app:strokeWidth="1dp"
                        app:cardElevation="2dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/txtTooltipTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#1D4FFF"
                                android:textStyle="bold"/>

                            <!-- Keterangan titik -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="4dp">

                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="@drawable/bg_step_number"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Titik tidak terdefinisi"
                                    android:textSize="10sp"
                                    android:textColor="#6B7280"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="#1D4FFF"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Nilai limit (pendekatan)"
                                    android:textSize="10sp"
                                    android:textColor="#6B7280"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTooltipEq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="11sp"
                                android:textColor="#374151"
                                android:textStyle="italic"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Zoom buttons -->
                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnZoomIn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:textColor="#4B5563"
                            android:textAllCaps="false"
                            android:backgroundTint="#FFFFFF"
                            android:elevation="4dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#E5E7EB"
                            app:strokeWidth="1dp"/>

                        <Button
                            android:id="@+id/btnZoomOut"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:textColor="#4B5563"
                            android:textAllCaps="false"
                            android:backgroundTint="#FFFFFF"
                            android:elevation="4dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#E5E7EB"
                            app:strokeWidth="1dp"/>

                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label langkah -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Langkah Penyelesaian"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111827"/>

            <!-- STEP 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step1Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/step1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#111827"/>

                            <TextView
                                android:id="@+id/step1Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp"
                                android:textColor="#6B7280"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/step1Formula"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step1Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step1Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step2Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/step2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#111827"/>

                            <TextView
                                android:id="@+id/step2Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp"
                                android:textColor="#6B7280"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/step2Formula"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step2Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step2Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/step3Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#1D4FFF"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/step3Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#111827"/>

                            <TextView
                                android:id="@+id/step3Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp"
                                android:textColor="#6B7280"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/step3Formula"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:textSize="13sp"
                            android:textColor="#6B7280"/>

                        <ImageView
                            android:id="@+id/step3Arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9CA3AF"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/step3Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="62dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HASIL AKHIR CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0F4FF"
                app:strokeColor="#C7D7FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasil Akhir"
                        android:textColor="#1D4FFF"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/txtHasilAkhir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#1D4FFF"
                        android:textStyle="bold"
                        android:textSize="22sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- KEYBOARD PANEL sticky di bawah -->
    <LinearLayout
        android:id="@+id/keyboardPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <!-- Handle untuk menutup keyboard -->
        <LinearLayout
            android:id="@+id/btnHideKeyboard"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#E5E7EB"
                android:backgroundTint="#D1D5DB"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E5E7EB"
            android:layout_marginBottom="8dp"/>

        <!-- Row 1: sin cos tan ln log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnSin"  style="@style/KeyboardButtonStyle" android:text="sin"/>
            <Button android:id="@+id/btnCos"  style="@style/KeyboardButtonStyle" android:text="cos"/>
            <Button android:id="@+id/btnTan"  style="@style/KeyboardButtonStyle" android:text="tan"/>
            <Button android:id="@+id/btnLn"   style="@style/KeyboardButtonStyle" android:text="ln"/>
            <Button android:id="@+id/btnLog"  style="@style/KeyboardButtonStyle" android:text="log"/>
        </LinearLayout>

        <!-- Row 2: √x x² xʸ π e -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btnSqrt"   style="@style/KeyboardButtonStyle" android:text="√x"/>
            <Button android:id="@+id/btnSquare" style="@style/KeyboardButtonStyle" android:text="x²"/>
            <Button android:id="@+id/btnPow"    style="@style/KeyboardButtonStyle" android:text="xʸ"/>
            <Button android:id="@+id/btnPi"     style="@style/KeyboardButtonStyle" android:text="π"/>
            <Button android:id="@+id/btnE"      style="@style/KeyboardButtonStyle" android:text="e"/>
        </LinearLayout>

        <!-- Row 3: 7 8 9 / ⌫ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn7"         style="@style/KeyboardButtonStyle" android:text="7"/>
            <Button android:id="@+id/btn8"         style="@style/KeyboardButtonStyle" android:text="8"/>
            <Button android:id="@+id/btn9"         style="@style/KeyboardButtonStyle" android:text="9"/>
            <Button android:id="@+id/btnDivide"    style="@style/KeyboardButtonStyle" android:text="/"/>
            <Button android:id="@+id/btnBackspace" style="@style/KeyboardButtonStyle" android:text="⌫"/>
        </LinearLayout>

        <!-- Row 4: 4 5 6 * / -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn4"        style="@style/KeyboardButtonStyle" android:text="4"/>
            <Button android:id="@+id/btn5"        style="@style/KeyboardButtonStyle" android:text="5"/>
            <Button android:id="@+id/btn6"        style="@style/KeyboardButtonStyle" android:text="6"/>
            <Button android:id="@+id/btnMultiply" style="@style/KeyboardButtonStyle" android:text="*"/>
            <Button android:id="@+id/btnCaret"    style="@style/KeyboardButtonStyle" android:text="/"/>
        </LinearLayout>

        <!-- Row 5: 1 2 3 − ( -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn1"         style="@style/KeyboardButtonStyle" android:text="1"/>
            <Button android:id="@+id/btn2"         style="@style/KeyboardButtonStyle" android:text="2"/>
            <Button android:id="@+id/btn3"         style="@style/KeyboardButtonStyle" android:text="3"/>
            <Button android:id="@+id/btnMinus"     style="@style/KeyboardButtonStyle" android:text="−"/>
            <Button android:id="@+id/btnOpenParen" style="@style/KeyboardButtonStyle" android:text="("/>
        </LinearLayout>

        <!-- Row 6: 0 . ) + = -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/btn0"          style="@style/KeyboardButtonStyle" android:text="0"/>
            <Button android:id="@+id/btnDot"        style="@style/KeyboardButtonStyle" android:text="."/>
            <Button android:id="@+id/btnCloseParen" style="@style/KeyboardButtonStyle" android:text=")"/>
            <Button android:id="@+id/btnPlus"       style="@style/KeyboardButtonStyle" android:text="+"/>
            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1D4FFF"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Row 7: x  AC  Hitung Limit (SATU TOMBOL SAJA) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">

            <Button
                android:id="@+id/btnX"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#F9FAFB"
                android:text="x"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp"/>

            <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:backgroundTint="#FFF3F3"
                android:text="AC"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp"/>

            <Button
                android:id="@+id/btnHitungBottom"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:layout_marginStart="5dp"
                android:backgroundTint="#1D4FFF"
                android:text="Hitung"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
